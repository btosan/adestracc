generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  category    String
  createdAt   DateTime @default(now())
}

model NewsItem {
  id          String   @id @default(cuid())
  title       String
  excerpt     String
  content     String
  imageUrl    String?
  slug        String   @unique
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}
